#!/bin/sh
# ~/.config/bspwm/bspwmrc — Tokyo Night, minimal (after legenddots/bspwm)
# bspwm does nothing on its own; this script configures it and starts the bits
# around it. sxhkd owns the keybinds (see ../sxhkd/sxhkdrc). No recompiling, ever.

xsetroot -solid "#1a1b26" -cursor_name left_ptr    # flat Tokyo Night background
setxkbmap @KB_LAYOUT@                              # keyboard layout (set KB_LAYOUT=... when installing)

sxhkd &                               # keybind daemon
picom &                               # compositor
dunst &                               # notifications
"$HOME/.config/dzen2/bar.sh" &        # the bar: ram · battery · date (dzen2, C)
( sleep 3; "$HOME/.config/fastfetch/fastfetch-html" ) &   # ~/fastfetch.html: the page Dillo opens (super+w)

bspc monitor -d 1 2 3 4 5 6 7 8 9

bspc config border_width          2
bspc config window_gap            6
bspc config normal_border_color   "#1a1b26"
bspc config focused_border_color  "#7aa2f7"
bspc config split_ratio           0.52
bspc config borderless_monocle    true
bspc config gapless_monocle       true
bspc config focus_follows_pointer true
bspc config top_padding           24          # room for the bar
