#!/usr/bin/env python3
# ~/.config/dillo/www-server — a terminal in Dillo.
#
# Serves a terminal-style page on http://127.0.0.1:8080 (loopback only). Dillo has no JavaScript, so the prompt is an
# HTML form: type a command, press Enter, the page comes back with the output appended. Commands run in a real
# pseudo-terminal (colours, fastfetch, ls --color ... work); `cd` persists, `clear` empties the screen. No full-screen
# programs (top, nvim...): there is no terminal on the other end. Each command has a 25 s limit.
#
# SECURITY: this runs commands as you, so it is locked down. A random token is made at start and kept in
# ~/.cache/www-token (mode 0600, directory 0700). The terminal page and the run endpoint need that token, requests with
# a foreign Host header are refused (DNS rebinding), and running needs a POST. The launcher (www-open) hands the token
# to Dillo through a 0600 file, so it never appears in a process list. ~/www (index.html, fastfetch.html) is served
# without a token: it holds no secrets and runs nothing. fastfetch.html is regenerated on every load.

import fcntl, functools, hmac, html, http.server, importlib.machinery, importlib.util, os, pty, secrets, select
import signal, socket, struct, subprocess, sys, termios, threading, time, urllib.parse

HOME = os.path.expanduser("~")
ROOT = os.path.join(HOME, "www")
CACHE = os.path.join(HOME, ".cache")
TOKEN_FILE = os.path.join(CACHE, "www-token")
GEN = os.path.join(HOME, ".config", "dillo", "fastfetch-html")
PORT = int(sys.argv[1]) if len(sys.argv) > 1 else 8080
HOST_OK = {"localhost:%d" % PORT, "127.0.0.1:%d" % PORT}
COLS, ROWS, LIMIT_S, CAP = 100, 30, 25, 200_000
SHELL = os.environ.get("SHELL", "/bin/bash")

# reuse the ANSI -> HTML converter and the palette from fastfetch-html
_l = importlib.machinery.SourceFileLoader("fastfetch_html", GEN)
_s = importlib.util.spec_from_loader("fastfetch_html", _l)
ffh = importlib.util.module_from_spec(_s)
_l.exec_module(ffh)

TOKEN = secrets.token_urlsafe(24)
os.makedirs(CACHE, mode=0o700, exist_ok=True)
os.chmod(CACHE, 0o700)
fd = os.open(TOKEN_FILE, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
with os.fdopen(fd, "w") as f:
    f.write(TOKEN + "\n")

LOCK = threading.Lock()                  # one command at a time keeps cwd/history simple
STATE = {"cwd": HOME, "history": [], "started": False, "n": 0}   # history: (prompt, command, output_ansi)

PREAMBLE = ('ls() { command ls --color=auto "$@"; }; grep() { command grep --color=auto "$@"; }; '
            'diff() { command diff --color=auto "$@"; }\n')


def short_cwd(path):
    return "~" + path[len(HOME):] if path == HOME or path.startswith(HOME + "/") else path


def prompt_for(cwd):
    return "%s@%s:%s$" % (os.environ.get("USER") or os.path.basename(HOME), socket.gethostname(), short_cwd(cwd))


def run_command(cmd, cwd):
    """Run cmd in a bash with a real pty. Returns (output, new_cwd)."""
    master, slave = pty.openpty()
    fcntl.ioctl(slave, termios.TIOCSWINSZ, struct.pack("HHHH", ROWS, COLS, 0, 0))
    script = PREAMBLE + cmd + '\n__rc=$?; printf "\\n__SMGL_CWD__%s\\n" "$PWD"; exit $__rc'
    env = dict(os.environ, TERM="xterm-256color", COLORTERM="truecolor", COLUMNS=str(COLS), LINES=str(ROWS))
    env.pop("TERM_PROGRAM", None)
    p = subprocess.Popen([SHELL, "--noprofile", "--norc", "-c", script], cwd=cwd, env=env, stdin=slave, stdout=slave,
                         stderr=slave, start_new_session=True, close_fds=True,
                         preexec_fn=lambda: fcntl.ioctl(0, termios.TIOCSCTTY, 0))
    os.close(slave)
    out, deadline, timed_out = b"", time.time() + LIMIT_S, False
    while True:
        left = deadline - time.time()
        if left <= 0:
            timed_out = True
            break
        r, _, _ = select.select([master], [], [], min(left, 0.5))
        if r:
            try:
                chunk = os.read(master, 65536)
            except OSError:               # EIO: the child closed the pty
                break
            if not chunk:
                break
            out += chunk
            if len(out) > CAP:
                out = out[:CAP] + b"\r\n[output truncated]\r\n"
                timed_out = True
                break
        elif p.poll() is not None:
            break
    if timed_out or p.poll() is None:
        try:
            os.killpg(p.pid, signal.SIGKILL)
        except OSError:
            pass
        out += b"\r\n[killed: %d s limit]\r\n" % LIMIT_S if timed_out and len(out) <= CAP else b""
    p.wait()
    os.close(master)
    text = out.decode("utf-8", "replace")
    new_cwd, marker = cwd, "__SMGL_CWD__"
    if marker in text:
        head, _, tail = text.rpartition(marker)
        cand = tail.splitlines()[0].strip() if tail.splitlines() else ""
        if cand and os.path.isdir(cand):
            new_cwd = cand
        text = head.rstrip("\r\n")
    return text, new_cwd


def page(extra_head=""):
    hist = []
    for prompt, cmd, out in STATE["history"]:
        hist.append("%s %s" % (html.escape(prompt), html.escape(cmd)))
        body = ffh.ansi_to_html(out).strip("\n")
        if body:
            hist.append(body)
    cur = prompt_for(STATE["cwd"])
    return """<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<title>%(host)s - terminal</title>
<style type="text/css">
body     { background-color: %(page)s; color: %(fg)s; margin: 20px 30px; font-family: "JetBrains Mono", monospace; }
td.box   { background-color: %(box)s; border: 1px solid #2f334d; padding: 12px 16px; }
pre      { background-color: %(box)s; color: %(fg)s; margin: 0; font-size: 11px; }
td.ps    { color: %(fg)s; font-size: 11px; }
a        { color: #7aa2f7; }
</style>
</head>
<body>
<table><tr><td class="box">
<pre>%(hist)s</pre>
<form action="/run" method="post">
<input type="hidden" name="t" value="%(tok)s">
<table><tr><td class="ps">%(prompt)s</td>
<td><input type="text" name="cmd" size="70" style="background-color:%(box)s;color:%(fg)s"></td></tr></table>
</form>
<a name="end"></a>
</td></tr></table>
<p><a href="/index.html">back</a> &middot; <span style="color:#565f89">type a command, press Enter &middot; clear empties the screen</span></p>
</body>
</html>
""" % dict(host=html.escape(socket.gethostname()), page=ffh.PAGE, fg=ffh.FG, box=ffh.BOX, tok=TOKEN,
           hist="\n".join(hist), prompt=html.escape(cur))


class Handler(http.server.SimpleHTTPRequestHandler):
    def _host_ok(self):
        return (self.headers.get("Host") or "").lower() in HOST_OK

    def _deny(self, code=403, msg="forbidden"):
        self.send_response(code)
        self.send_header("Content-Type", "text/plain")
        self.end_headers()
        self.wfile.write(msg.encode())

    def _send(self, body, code=200, ctype="text/html; charset=utf-8", extra=None):
        data = body.encode()
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store")
        self.send_header("Referrer-Policy", "no-referrer")          # the URL carries the token
        for k, v in (extra or {}).items():
            self.send_header(k, v)
        self.end_headers()
        self.wfile.write(data)

    def _token_ok(self, t):
        # bytes, not str: compare_digest raises on non-ASCII str, which a crafted URL could otherwise trigger
        return bool(t) and hmac.compare_digest(t.encode("utf-8", "surrogateescape"), TOKEN.encode())

    def _origin_ok(self):
        # a cross-site form POST carries the attacker page's Origin: refuse it even before the token check
        o = self.headers.get("Origin")
        return o is None or o.lower() in {"http://" + h for h in HOST_OK}

    def do_GET(self):
        if not self._host_ok():
            return self._deny()
        url = urllib.parse.urlsplit(self.path)
        q = urllib.parse.parse_qs(url.query)
        if url.path == "/" and "t" in q:                         # the terminal (needs the token)
            if not self._token_ok(q["t"][0]):
                return self._deny()
            with LOCK:
                if not STATE["started"]:
                    STATE["started"] = True
                    out, STATE["cwd"] = run_command("fastfetch", STATE["cwd"])
                    STATE["history"].append((prompt_for(HOME), "fastfetch", out))
                return self._send(page())
        if url.path == "/fastfetch.html" and os.path.exists(GEN):   # public, no secrets: regenerated on every load
            try:
                subprocess.run([GEN], timeout=40, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                               stderr=subprocess.DEVNULL)
            except Exception:
                pass
        if url.path == "/" or url.path == "":
            self.path = "/index.html"
        super().do_GET()

    def do_POST(self):
        if not self._host_ok() or not self._origin_ok() or self.path != "/run":
            return self._deny()
        try:
            n = int(self.headers.get("Content-Length", "0"))
        except ValueError:
            return self._deny(400, "bad request")
        if n <= 0 or n > 8192:
            return self._deny(413, "too large")
        form = urllib.parse.parse_qs(self.rfile.read(n).decode("utf-8", "replace"))
        if not self._token_ok((form.get("t") or [""])[0]):
            return self._deny()
        cmd = (form.get("cmd") or [""])[0].strip()
        with LOCK:
            if cmd == "clear":
                STATE["history"] = []
            elif cmd:
                out, newcwd = run_command(cmd, STATE["cwd"])
                STATE["history"].append((prompt_for(STATE["cwd"]), cmd, out))
                STATE["cwd"] = newcwd
                del STATE["history"][:-60]
        # a changing &n=: Dillo treats a URL that differs only by #fragment as the same page and would not refetch it
        STATE["n"] += 1
        self.send_response(303)
        self.send_header("Location", "/?t=%s&n=%d#end" % (TOKEN, STATE["n"]))
        self.send_header("Content-Length", "0")
        self.end_headers()

    def log_message(self, *args):
        pass


os.makedirs(ROOT, exist_ok=True)
if not os.path.exists(os.path.join(ROOT, "index.html")) and os.path.exists(GEN):
    subprocess.run([GEN], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
http.server.ThreadingHTTPServer(("127.0.0.1", PORT), functools.partial(Handler, directory=ROOT)).serve_forever()
