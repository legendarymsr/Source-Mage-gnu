#!/usr/bin/env python3
# ~/.config/dillo/fastfetch-html — show fastfetch in Dillo as a terminal-style page.
#
#   fastfetch-html [output.html]     default: ~/www/fastfetch.html
#
# Runs the real fastfetch with YOUR config (colours included) and converts its ANSI output to HTML inside a dark
# "terminal" box with a prompt line and a cursor. www-server serves ~/www on http://localhost:8080 and runs this on
# every load of /fastfetch.html, so reloading Dillo re-runs fastfetch; super+w opens it. Nothing is faked: fastfetch
# reports what it really detects (its parent is the python web server, so shell/terminal show that). Standard
# library only; Dillo has no JavaScript and basic CSS, so the page is a <pre> full of coloured <span>s.

import getpass, html, os, re, shutil, socket, subprocess, sys

HOME = os.path.expanduser("~")
OUT = sys.argv[1] if len(sys.argv) > 1 else os.path.join(HOME, "www", "fastfetch.html")

# st's Tokyo Night palette (the colorname[] table in st's config.h), so the page matches the terminal
BASE16 = ["#15161e", "#f7768e", "#9ece6a", "#e0af68", "#7aa2f7", "#bb9af7", "#7dcfff", "#a9b1d6",
          "#414868", "#f7768e", "#9ece6a", "#e0af68", "#7aa2f7", "#bb9af7", "#7dcfff", "#c0caf5"]
FG, BOX, PAGE = "#c0caf5", "#1a1b26", "#16161e"


def fastfetch_ansi():
    """The real fastfetch output, colours included (--pipe false keeps the ANSI codes when stdout is a pipe)."""
    r = subprocess.run(["fastfetch", "--pipe", "false"], capture_output=True, text=True,
                       env=dict(os.environ, TERM="xterm-256color"), stdin=subprocess.DEVNULL, timeout=30)
    return r.stdout


def xterm256(n):
    if n < 16:
        return BASE16[n]
    if n < 232:
        n -= 16
        lv = [0, 95, 135, 175, 215, 255]
        return "#%02x%02x%02x" % (lv[n // 36], lv[(n // 6) % 6], lv[n % 6])
    g = 8 + (n - 232) * 10
    return "#%02x%02x%02x" % (g, g, g)


def ansi_to_html(text):
    """Tiny terminal emulator: SGR colours/bold, ESC[nG / ESC[nC cursor moves, newlines."""
    lines, line, col = [], [], 0
    fg, bg, bold = None, None, False
    i, n = 0, len(text)

    def put(ch):
        nonlocal col
        cell = (ch, fg, bg, bold)
        while len(line) < col:
            line.append((" ", None, None, False))
        if col < len(line):
            line[col] = cell
        else:
            line.append(cell)
        col += 1

    while i < n:
        c = text[i]
        if c == "\x1b" and text.startswith("[", i + 1):
            m = re.match(r"\x1b\[([0-9;?]*)([A-Za-z])", text[i:])
            if not m:
                i += 1
                continue
            params, final = m.group(1), m.group(2)
            i += m.end()
            nums = [int(x) if x.isdigit() else 0 for x in params.split(";")] if params else []
            if final == "m":
                k = 0
                nums = nums or [0]
                while k < len(nums):
                    v = nums[k]
                    if v == 0: fg = bg = None; bold = False
                    elif v == 1: bold = True
                    elif v == 22: bold = False
                    elif 30 <= v <= 37: fg = BASE16[v - 30]
                    elif 90 <= v <= 97: fg = BASE16[v - 90 + 8]
                    elif v == 39: fg = None
                    elif 40 <= v <= 47: bg = BASE16[v - 40]
                    elif 100 <= v <= 107: bg = BASE16[v - 100 + 8]
                    elif v == 49: bg = None
                    elif v in (38, 48) and k + 1 < len(nums):
                        if nums[k + 1] == 2 and k + 4 < len(nums):
                            colr = "#%02x%02x%02x" % tuple(nums[k + 2:k + 5]); k += 4
                        elif nums[k + 1] == 5 and k + 2 < len(nums):
                            colr = xterm256(nums[k + 2]); k += 2
                        else:
                            colr = None
                        if v == 38: fg = colr
                        else: bg = colr
                        k += 1
                    k += 1
            elif final == "G":
                col = max(0, (nums[0] if nums else 1) - 1)
            elif final == "C":
                col += nums[0] if nums else 1
            elif final == "D":
                col = max(0, col - (nums[0] if nums else 1))
            continue                      # any other CSI sequence (cursor visibility, erase, ...) is ignored
        if c == "\n":
            lines.append(line); line, col = [], 0
        elif c == "\r":
            col = 0
        elif c >= " ":
            put(c)
        i += 1
    if line:
        lines.append(line)

    out = []
    for ln in lines:
        while ln and ln[-1][0] == " " and ln[-1][2] is None:
            ln = ln[:-1]
        s, k = "", 0
        while k < len(ln):
            _, f, b, bd = ln[k]
            j = k
            while j < len(ln) and ln[j][1:] == (f, b, bd):
                j += 1
            chunk = html.escape("".join(ch for ch, *_ in ln[k:j]), quote=False)
            style = ";".join(x for x in (f and "color:" + f, b and "background-color:" + b, bd and "font-weight:bold") if x)
            s += ('<span style="%s">%s</span>' % (style, chunk)) if style else chunk
            k = j
        out.append(s)
    return "\n".join(out)


def main():
    user, host = getpass.getuser(), socket.gethostname()
    prompt = "%s@%s:~$" % (user, host)
    body = ansi_to_html(fastfetch_ansi()).strip("\n")
    cursor = '<span style="background-color:%s;color:%s"> </span>' % (FG, BOX)
    page = """<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<title>fastfetch - %(host)s</title>
<style type="text/css">
body     { background-color: %(page)s; color: %(fg)s; margin: 20px 30px; font-family: "JetBrains Mono", monospace; }
pre.term { background-color: %(box)s; color: %(fg)s; border: 1px solid #2f334d; padding: 12px 16px; margin: 0 0 14px 0; font-size: 13px; }
a        { color: #7aa2f7; }
</style>
</head>
<body>
<pre class="term">%(prompt)s fastfetch
%(body)s

%(prompt)s %(cursor)s</pre>
<p><a href="/">back</a></p>
</body>
</html>
""" % dict(host=html.escape(host), page=PAGE, fg=FG, box=BOX, prompt=html.escape(prompt), body=body, cursor=cursor)
    os.makedirs(os.path.dirname(OUT), exist_ok=True)
    with open(OUT, "w") as f:
        f.write(page)
    index = os.path.join(os.path.dirname(OUT), "index.html")
    if not os.path.exists(index):
        with open(index, "w") as f:
            f.write("""<!DOCTYPE html>
<html><head><meta charset="utf-8"><title>%(host)s</title>
<style type="text/css">
body { background-color: %(page)s; color: %(fg)s; margin: 30px; font-family: "JetBrains Mono", monospace; }
h1 { color: #bb9af7; } a { color: #7aa2f7; }
</style></head>
<body><h1>%(host)s</h1>
<p>served from ~/www on http://localhost:8080</p>
<ul><li><a href="fastfetch.html">fastfetch</a></li></ul>
</body></html>
""" % dict(host=html.escape(host), page=PAGE, fg=FG))


if __name__ == "__main__":
    if not shutil.which("fastfetch"):
        sys.exit("fastfetch-html: fastfetch not found")
    main()
