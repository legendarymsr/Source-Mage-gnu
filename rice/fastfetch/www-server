#!/usr/bin/env python3
# ~/.config/fastfetch/www-server — serve ~/www on http://127.0.0.1:8080 (loopback only) for Dillo.
# /fastfetch.html is regenerated by fastfetch-html on every request, so a reload in Dillo re-runs fastfetch.
import functools, http.server, os, subprocess, sys

HOME = os.path.expanduser("~")
ROOT = os.path.join(HOME, "www")
GEN = os.path.join(HOME, ".config", "fastfetch", "fastfetch-html")
PORT = int(sys.argv[1]) if len(sys.argv) > 1 else 8080


class Handler(http.server.SimpleHTTPRequestHandler):
    def do_GET(self):
        if self.path.split("?")[0] == "/fastfetch.html" and os.path.exists(GEN):
            try:
                subprocess.run([GEN], timeout=40, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                               stderr=subprocess.DEVNULL)
            except Exception:
                pass                      # fall back to the last generated page
        super().do_GET()

    def log_message(self, *args):         # no log spam
        pass


os.makedirs(ROOT, exist_ok=True)
if not os.path.exists(os.path.join(ROOT, "index.html")) and os.path.exists(GEN):
    subprocess.run([GEN], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
srv = http.server.ThreadingHTTPServer(("127.0.0.1", PORT), functools.partial(Handler, directory=ROOT))
srv.serve_forever()
