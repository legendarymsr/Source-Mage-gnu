. "${GRIMOIRE}/MESON_DEPENDS" &&
depends PKG-CONFIG            &&
depends libx11                &&
depends libxcb                &&
depends libxext               &&
depends xorgproto             &&
depends xcb-util              &&
depends libxdamage            &&
depends libxfixes             &&
depends xcb-util-renderutil   &&
depends xcb-util-image        &&
depends pixman                &&
# regex support wants the old PCRE (libpcre), which the grimoire does not offer (it lists pcre2): force it off.
# It used to be off only by accident, until pcre2 happened to be installed first.
depends libev "regex=false"   &&
depends uthash                &&

optional_depends dbus                                         \
                 'dbus=true'                                  \
                 'dbus=false'                                 \
                 'Enable support for D-Bus remote control?'   &&

optional_depends libconfig                                    \
                 'config_file=true'                           \
                 'config_file=false'                          \
                 'Enable config file support?'                &&

optional_depends OPENGL                                       \
                 'opengl=true'                                \
                 'opengl=false'                               \
                 'Enable features that require OpenGL?'
