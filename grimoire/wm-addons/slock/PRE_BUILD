default_pre_build                                                  &&
cd $SOURCE_DIRECTORY                                               &&
# legenddots Tokyo Night config.h (colours, failonclear); user "nobody" / group "nogroup" exist on Source Mage
cp "${SPELL_DIRECTORY}/config.h" config.h                          &&
